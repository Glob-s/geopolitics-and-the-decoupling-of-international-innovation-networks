. capture program drop _treated_control_counts

. program define _treated_control_counts, rclass
  1.         syntax varlist, ID(varname)
  2.         di "`varlist'"
  3.         preserve
  4.                 keep `id' `varlist'
  5.                 bys `id': egen ever_shock = max(`varlist')
  6.                 bys `id': keep if _n == 1
  7.                 count if ever_shock == 1
  8.                 return scalar N_treated = r(N)
  9.                 count if ever_shock == 0
 10.                 return scalar N_control = r(N)
 11.         restore
 12. end

. 
end of do-file

