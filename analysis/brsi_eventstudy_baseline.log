. cap program drop _add_pooled_effects

. program define _add_pooled_effects
  1.         version 18.0
  2.         syntax , VARS(string) TITLE(string)
  3.         local n: word count(`vars')
  4.         local expr ""
  5.         foreach v of local vars{
  6.                 if "`expr'" == "" {
  7.                         local expr "`v'"
  8.                 }
  9.                 else {
 10.                         local expr "`expr' + `v'"
 11.                 }
 12.         }
 13.         putdocx paragraph, style(Heading3)
 14.         putdocx text ("`title'")
 15.         quietly lincom (`expr')/`n'
 16.         putdocx table eff = (2, 6)
 17.         putdocx table eff(1,1) = ("Coefficient"), bold
 18.         putdocx table eff(1,2) = ("Std. err."), bold
 19.         putdocx table eff(1,3) = ("z"), bold
 20.         putdocx table eff(1,4) = ("p-value"), bold
 21.         putdocx table eff(1,5) = ("95% l"), bold
 22.         putdocx table eff(1,6) = ("95% u"), bold
 23.         putdocx table eff(2,1) = (strofreal(r(estimate), "$NUMFMT"))
 24.         putdocx table eff(2,2) = (strofreal(r(se), "$NUMFMT"))
 25.         putdocx table eff(2,3) = (strofreal(r(z), "$NUMFMT"))
 26.         putdocx table eff(2,4) = (strofreal(r(p), "$NUMFMT"))
 27.         putdocx table eff(2,5) = (strofreal(r(lb), "$NUMFMT"))
 28.         putdocx table eff(2,6) = (strofreal(r(ub), "$NUMFMT"))
 29. end

. 
. cap program drop _export_table_with_plot

. program define _export_table_with_plot
  1.     version 18.0
  2.     syntax , DV(string) ES(string) TITLE(string) OUTDOC(string) NTREAT(real
> ) NCTRL(real)
  3.     
.     matrix coefs = r(table)
  4.     
.     preserve
  5.         * PNG path
.         local outpng = subinstr("`outdoc'","tables/","figs/",.)
  6.         local outpng = subinstr("`outpng'",".docx",".png",.)
  7. 
.         coefplot `es', ///
>             keep($relvars) ///
>             xline(3) vertical ///
>             xlabel(1 "-3" 2 "-2" 3 "0" 4 "1" 5 "2" 6 "3" 7 "4" 8 "5") ///
>             ytitle("Effect on `dv'") ///
>             xtitle("Years relative to BRSI shock")
  8.            
.         graph export "`outpng'", replace
  9. 
.         * DOCX export
.         putdocx clear
 10.         putdocx begin, pagesize(letter) font("Arial",10)
 11.         putdocx paragraph, style(Heading1)
 12.         putdocx text ("`title'")
 13.         
.         putdocx paragraph, style(Heading2)
 14.         putdocx text ("Event-time dynamics (-$L..$H)")
 15.         matrix table_transposed = coefs'
