.         * Pooled effects
.         putdocx paragraph, style(Heading2)
 18.         putdocx text ("Pooled effects")
 19.         
.         * Pre-trend
.         _add_pooled_effects, vars("rel_m3 rel_m2") title("Pre-treatment effect
> s (-3 -2)")
 20.         
.         * Post-avg
.         _add_pooled_effects, vars("rel_0 rel_1 rel_2 rel_3 rel_4 rel_5") title
> ("Post-treatment effects (0 5)")
 21.         
.         * Short-run 
.         _add_pooled_effects, vars("rel_0 rel_1") title("Short-run effects (0 1
> )")
 22.         
.         * Medium-run
.         _add_pooled_effects, vars("rel_2 rel_3") title("Medium-run effects (2 
> 3)")
 23.         
.         * Long-run
.         _add_pooled_effects, vars("rel_4 rel_5") title("Long-run effects (4 5)
> ")
 24.         
.         * Chi-2 and degrees of freedom
.         local chi2 = e(chi2)
